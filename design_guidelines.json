      "h3_card": "text-xl sm:text-2xl font-medium tracking-tight",
      "subtitle": "text-base sm:text-lg text-neutral-400 font-light leading-relaxed",
      "body": "text-sm sm:text-base leading-relaxed text-neutral-300",
      "caption": "text-xs font-mono uppercase tracking-[0.25em] text-amber-400/80"
