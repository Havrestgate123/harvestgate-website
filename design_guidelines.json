    "spacing_scale": {
      "section_y": "py-16 sm:py-24 lg:py-32",
      "card_p": "p-6 sm:p-8 lg:p-10",
      "gap_between_sections": "space-y-24 lg:space-y-36"
    }
  },
  "key_components": {
    "navbar": {
      "style": "Sticky top-0 z-50 backdrop-blur-xl border-b bg-[#0A0A0A]/80 border-[#262626] transition-colors duration-300",
      "elements": [
        "Brand Logo (HarvestGate Overseas emblem in Ochre Gold)",
        "Desktop Links: Home, Products, About Us, Quality & Export, Contact",
        "Theme Toggle Button (Sun/Moon with smooth rotation)",
        "Primary CTA Button: 'Request Export Quotation'",
        "Mobile Navigation Trigger & Fullscreen Drawer Menu with editorial typography"
      ]
    },
    "kinetic_hero": {
      "headline_line_1": "CULTIVATED IN INDIA.",
      "headline_line_2": "DELIVERED TO THE WORLD.",
      "italic_accent": "Pure, certified agricultural exports crafted for global enterprise scale.",
      "effects": "Masked line-by-line reveal animation using Framer Motion, subtle dark vignette canvas background, quick stat badges (45+ Export Countries, ISO 22000, 100% Traceable Sourcing)."
    },
    "manifesto_section": {
      "title": "THE HARVESTGATE MANIFESTO",
      "chapters": [
        {
          "number": "01",
          "title": "Single-Origin Direct Sourcing",
          "description": "We bypass intermediaries by contracting directly with agrarian cooperatives across Bihar, Jammu & Kashmir, Rajasthan, and Maharashtra."
        },
        {
          "number": "02",
          "title": "Phytosanitary & Lab Rigor",
          "description": "Every container batch undergoes triple-stage lab analysis for moisture, aflatoxins, heavy metals, and pesticide compliance before port dispatch."
        },
        {
          "number": "03",
          "title": "Temperature & Moisture Locked Export Packaging",
          "description": "Custom vacuum sealing, MAP (Modified Atmosphere Packaging), and nitrogen-flushed bulk containers safeguard crunch, aroma, and shelf-life."
        },
        {
          "number": "04",
          "title": "Guaranteed Incoterms & Freight Security",
          "description": "FOB, CIF, CFR options with complete documentation: Certificate of Origin, APEDA, FSSAI, Phytosanitary Certificate, and Phytoclean certification."
        }
      ]
    },
    "editorial_marquee": {
      "text": "HARVESTGATE OVERSEAS • PREMIUM INDIAN EXPORTS • PHOOL MAKHANA • ORGANIC MILLETS • KASHMIRI WALNUTS • ARTISANAL JAGGERY • WORLDWIDE LOGISTICS • ISO 22000 & HACCP CERTIFIED • APEDA REGISTERED EXPORTER • ",
      "style": "bg-[#121212] py-4 border-y border-[#262626] font-mono text-xs uppercase tracking-[0.3em] text-[#C8A24E]"
