{
  "project_info": {
    "name": "HarvestGate Overseas Private Limited",
    "description": "Dark-luxury, editorial-style B2B Agricultural Export platform for international buyers, importers, and distributors sourcing premium Indian agricultural commodities.",
    "type": "marketing_site",
    "framework": "React JS (SPA) with React Router DOM v7 & Tailwind CSS",
    "design_archetype": "Luxury Editorial / Swiss High-Contrast Fusion"
  },
  "typography": {
    "heading_font": "Playfair Display, Cormorant Garamond, or Bebas Neue / Condensed Display for bold headlines",
    "accent_italic_font": "Cormorant Garamond, Playfair Display (Italic)",
    "body_font": "Plus Jakarta Sans, Outfit, or Inter",
    "mono_font": "JetBrains Mono or IBM Plex Mono for technical specs, grade tables, HS Codes",
